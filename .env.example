# Get an xAI key at console.x.ai. Only needed when MOCK_AI=0 or for Grok voice.
MOCK_AI=1
MOCK_DATA=1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image-2.0
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
DEFAULT_RADIUS_MILES=75
# grok uses xAI text-to-speech and speech-to-text. browser keeps both on this machine.
NEXT_PUBLIC_VOICE_ENGINE=grok
XAI_VOICE_ID=rex

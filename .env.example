# Cursor Pro does not provide an xAI API key. The running app needs its own key
# from console.x.ai. Ask the SpaceXAI table for Grok credits.
MOCK_AI=1
MOCK_DATA=1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image-2.0
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
DEFAULT_RADIUS_MILES=75
# grok falls back to the browser Web Speech API. Grok Voice is not wired up.
NEXT_PUBLIC_VOICE_ENGINE=browser
